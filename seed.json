   "steps": [
    {
     "t": "Pregătește tot dinainte",
     "d": "Tai carnea în cuburi mari și păstrezi oasele cu măduvă. Toci ceapa, ardeii, roșiile, țelina și usturoiul, fiecare în bolul lui, că intră pe rând. Cartofii îi cureți, îi tai cuburi și îi ții în apă rece până la final."
    },
    {
     "t": "Untura și kaizerul",
     "d": "Încălzești ceaunul gol, pui untura și kaizerul tăiat mărunt și le lași să sfârâie un pic."
    },
    {
     "t": "Ceapa cu chimen",
     "d": "Bagi ceapa, chimenul și un praf de sare și le călești 8-10 minute, amestecând din când în când."
    },
    {
     "t": "Usturoiul",
     "d": "Adaugi usturoiul și amesteci repede, fără să-l lași să se ardă."
    },
    {
     "t": "Carnea și boiaua",
     "d": "Pui carnea și o călești cam 10 minute. Abia acum vin sarea, piperul și boiaua, peste carne. Pusă direct în grăsimea fierbinte, boiaua se amărăște."
    },
    {
     "t": "Ardeii și țelina",
     "d": "Adaugi ardeii, ardeiul iute și țelina și le mai lași vreo 5 minute."
    },
    {
     "t": "Roșiile",
     "d": "Pui pasta de tomate și roșiile tăiate și amesteci bine."
    },
    {
     "t": "Apa",
     "d": "Torni cam 3 litri de apă caldă. La început pare prea zeamă, dar scade pe parcurs."
    },
    {
     "t": "Fierbe încet",
     "d": "Lași ceaunul pe foc mic, fără capac, cam 3 ore, și mai amesteci din când în când. Carnea trebuie să fie moale, dar nu complet gata, că mai stă cu cartofii."
    },
    {
     "t": "Cartofii",
     "d": "Scurgi cartofii și îi bagi în ceaun pentru încă 30-40 de minute. Ei îngroașă sosul, iar dacă se îngroașă prea tare mai pui până la jumătate de litru de apă caldă."
    },
    {
     "t": "Gustă și servește",
     "d": "Mai potrivești de sare și piper, presari pătrunjel tocat și îl dai la masă cu smântână și pâine proaspătă."
    }
   ],
   "tips": [
    "Ia bucăți ieftine, cu puțină grăsime și zgârciuri, gen pulpă sau rasol. Dau gust și leagă sosul.",
    "Ceapa multă nu e greșeală, îndulcește gulașul și îl face gros.",
    "Fierbe-l fără capac, ca să scadă zeama.",
    "A doua zi e și mai bun. Ține în frigider sau îl poți congela în porții."
   ],
